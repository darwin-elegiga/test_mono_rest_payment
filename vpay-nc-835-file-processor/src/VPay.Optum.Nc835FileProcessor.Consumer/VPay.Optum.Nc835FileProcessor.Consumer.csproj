<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>dotnet-VPay.Optum.Nc835FileProcessor.Consumer-6E394A11-429F-42C3-ADAE-4305CD01054B</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="System.IO.Abstractions" Version="13.2.43" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="VPay.Extensions.HealthChecks" Version="2.0.0" />
    <PackageReference Include="VPay.Extensions.Logging.GrayLog" Version="2.0.0" />
    <PackageReference Include="VPay.MassTransit.DependencyInjection" Version="3.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VPay.Optum.Nc835FileProcessor.Application\VPay.Optum.Nc835FileProcessor.Application.csproj" />
    <ProjectReference Include="..\VPay.Optum\VPay.Optum.csproj" />
  </ItemGroup>

  <ItemGroup>
    <_CopyGitHooks Include="../../scripts/git_hooks/*.*" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent" Condition=" '$(Configuration)' == 'Debug' ">
    <Exec Command="dotnet tool restore" />
    <Copy SourceFiles="@(_CopyGitHooks)" DestinationFolder="../../.git/hooks" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Retries="3" RetryDelayMilliseconds="300" />
  </Target>
</Project>