<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>4232d800-b699-45f5-8a7c-20ac86775ca4</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\..\docker-compose.dcproj</DockerComposeProjectPath>
    <DockerfileContext>..\..</DockerfileContext>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" />
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="Hellang.Middleware.ProblemDetails" />
    <PackageReference Include="MicroElements.Swashbuckle.FluentValidation" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Polly.Caching.Distributed" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.Newtonsoft" />
    <PackageReference Include="VPay.AspNetCore.Logging" />
    <PackageReference Include="VPay.AspNetCore.Mvc" />
    <PackageReference Include="VPay.AspNetCore.SwashBuckle" />
    <PackageReference Include="VPay.AspNetCore.SwashBuckle.HealthChecks" />
    <PackageReference Include="VPay.Extensions.Caching.Memory" />
    <PackageReference Include="VPay.Extensions.Logging.GrayLog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\database\VPay.Gateway.Data.Sql\VPay.Gateway.Data.Sql.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Application\VPay.Gateway.Application.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Common.Documents\VPay.Gateway.Common.Documents.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Common.Enrollments\VPay.Gateway.Common.Enrollments.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Common.Kubera\VPay.Gateway.Common.Kubera.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Common.Loaf\VPay.Gateway.Common.Loaf.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Common.MemberClaims\VPay.Gateway.Common.MemberClaims.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Common.PlatformConfig\VPay.Gateway.Common.PlatformConfig.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Common.Preferencing\VPay.Gateway.Common.Preferencing.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Common.Recon\VPay.Gateway.Common.Recon.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Common.RestPayments\VPay.Gateway.Common.RestPayments.csproj" />
    <ProjectReference Include="..\Vpay.Gateway.Common.Vpay\Vpay.Gateway.Common.Vpay.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Common\VPay.Gateway.Common.csproj" />
    <ProjectReference Include="..\VPay.Gateway.Identity\VPay.Gateway.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <_CopyGitHooks Include="../../scripts/git_hooks/*.*" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent" Condition=" '$(Configuration)' == 'Debug' ">
    <Exec Command="dotnet tool restore" />
    <Copy SourceFiles="@(_CopyGitHooks)" DestinationFolder="../../.git/hooks" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Retries="3" RetryDelayMilliseconds="300" />
  </Target>
</Project>
