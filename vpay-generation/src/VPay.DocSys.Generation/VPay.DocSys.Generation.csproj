<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VPay.DocSys.Generation</AssemblyName>
    <RootNamespace>VPay.DocSys.Generation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="fo_base_eft_fax.xsl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="fo_base_reminder_fax.xsl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="fo_base_transform.xsl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="StpC2B_Transform.xslt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" />
    <PackageReference Include="Duende.AccessTokenManagement" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="PDFium.LinuxV2" />
    <PackageReference Include="PDFiumCore" />
    <PackageReference Include="PDFiumSharp.NativeBinaries" />
    <PackageReference Include="PDFiumSharpV2" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Unidecode.NET" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VPay.DocSys.Generation.Common\VPay.DocSys.Generation.Common.csproj" />
    <ProjectReference Include="..\VPay.DocSys.Generation.Data\VPay.DocSys.Generation.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="BundledFax.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>BundledFax.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="BundledFax.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>BundledFax.Designer.cs</LastGenOutput>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Resources\Images\" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Resources\Images\tiltedcopy.pdf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>